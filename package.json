{
  "name": "express-response-engine",
  "version": "1.2.0",

  "repository": {
    "type": "git",
    "url": "git+https://github.com/yash-201/express-response-engine.git"
  },
  "bugs": {
    "url": "https://github.com/yash-201/express-response-engine/issues"
  },
  "homepage": "https://github.com/yash-201/express-response-engine#readme",
  "description": "A framework-agnostic, TypeScript-ready response and error handling engine for Express, featuring global middleware, custom ApiError helpers, validation formatting, response encryption, logging hooks, and request ID support.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "express-response-engine": "./bin/cli.js",
    "create-express-server": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "ts-node scratch/test.ts",
    "test:cli": "ts-node scratch/test-cli.ts",
    "test:all": "npm test && npm run test:cli",
    "example": "npm run build && npm --prefix example start",
    "start": "npm run example",
    "init": "node bin/cli.js",
    "create-server": "node bin/cli.js",
    "module": "node bin/cli.js module",
    "create-module": "node bin/cli.js module"
  },

  "keywords": [
    "express",
    "response",
    "error",
    "middleware",
    "interceptor",
    "api-response",
    "validation-formatter",
    "encryption",
    "async-handler",
    "cli",
    "scaffold",
    "server-generator"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "express": "^4.21.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "express-validator": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "express-validator": {
      "optional": true
    }
  }
}
